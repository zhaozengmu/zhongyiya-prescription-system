# ===== Django 基础 =====
# 生产环境必须显式设置（长度 50+ 随机串）；开发环境留空会自动使用不安全的默认值
DJANGO_SECRET_KEY=
# 生产必须为 False；留空默认 False（fail-closed，避免误把调试页暴露到公网）
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000

# ===== 数据存储 =====
# 留空使用 SQLite；生产建议 MySQL 8
DB_ENGINE=
DB_NAME=tcm_rms
DB_USER=tcm
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# 可选：独立缓存（未设置则退化为进程内 LocMemCache，多进程部署请配置 Redis）
REDIS_URL=

# ===== 安全 =====
# 患者身份证号、手机号等敏感字段的加密密钥（Fernet，44 位 base64）
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 生产环境缺失该变量会直接启动失败（防止明文落库）
DATA_ENCRYPTION_KEY=
# 仅在确实位于可信反向代理之后时才设为 True，否则审计日志 IP 可被伪造
TRUST_X_FORWARDED_FOR=False
# 登录失败锁定策略
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=600
